#include "common_defs.h"

static constexpr int IN_CH = __IN_CHANNELS__;
static constexpr int OUT_CH = __OUT_CHANNELS__;
static constexpr int IN_H = __FEATURE_H__;
static constexpr int IN_W = __FEATURE_W__;
static constexpr int K = __KERNEL_SIZE__;
static constexpr int STRIDE = __STRIDE__;
static constexpr int PAD = __PADDING__;
static constexpr int OUT_H = __OUT_H__;
static constexpr int OUT_W = __OUT_W__;
static constexpr int PADDED_W = IN_W + (2 * PAD);
static constexpr bool APPLY_RELU = (__APPLY_RELU__ != 0);

typedef MAKE_AXIS_TYPE(IN_CH * 8) input_axis_t;
typedef MAKE_AXIS_TYPE(OUT_CH * 8) output_axis_t;

void __TOP_FUNCTION__(
    hls::stream<input_axis_t> &input_stream,
    hls::stream<output_axis_t> &output_stream,
    const weight_t weights[OUT_CH][IN_CH][K][K],
    const acc_t biases[OUT_CH]
) {
DECLARE_AXIS_INTERFACE()
DECLARE_BRAM_WEIGHTS()
DECLARE_CONTROL_INTERFACE()

    weight_t weight_buffer[OUT_CH][IN_CH][K][K];
    acc_t bias_buffer[OUT_CH];
    data_t line_buffer[IN_CH][K][PADDED_W];
    data_t incoming_channels[IN_CH];
#pragma HLS ARRAY_PARTITION variable=weight_buffer dim=1 complete
#pragma HLS ARRAY_PARTITION variable=weight_buffer dim=2 complete
#pragma HLS ARRAY_PARTITION variable=weight_buffer dim=3 complete
#pragma HLS ARRAY_PARTITION variable=weight_buffer dim=4 complete
#pragma HLS ARRAY_PARTITION variable=bias_buffer dim=1 complete
#pragma HLS ARRAY_PARTITION variable=line_buffer dim=1 complete
#pragma HLS ARRAY_PARTITION variable=line_buffer dim=2 complete
#pragma HLS ARRAY_PARTITION variable=incoming_channels dim=1 complete

    // Initialization is off the throughput-critical path, so keep it simple.
    for (int oc = 0; oc < OUT_CH; ++oc) {
        bias_buffer[oc] = biases[oc];
    }
    for (int oc = 0; oc < OUT_CH; ++oc) {
        for (int ic = 0; ic < IN_CH; ++ic) {
            for (int kh = 0; kh < K; ++kh) {
                for (int kw = 0; kw < K; ++kw) {
                    weight_buffer[oc][ic][kh][kw] = weights[oc][ic][kh][kw];
                }
            }
        }
    }

    for (int ic = 0; ic < IN_CH; ++ic) {
        for (int kh = 0; kh < K; ++kh) {
            for (int pw = 0; pw < PADDED_W; ++pw) {
                line_buffer[ic][kh][pw] = 0;
            }
        }
    }

    for (int pw = 0; pw < PADDED_W; ++pw) {
#pragma HLS PIPELINE II=__PIPELINE_II__
        for (int ic = 0; ic < IN_CH; ++ic) {
#pragma HLS UNROLL
            incoming_channels[ic] = 0;
        }
        for (int ic = 0; ic < IN_CH; ++ic) {
#pragma HLS UNROLL
            line_buffer[ic][0][pw] = line_buffer[ic][1][pw];
            line_buffer[ic][1][pw] = line_buffer[ic][2][pw];
            line_buffer[ic][2][pw] = incoming_channels[ic];
        }
    }

    for (int h = 0; h < IN_H; ++h) {
        {
#pragma HLS PIPELINE II=__PIPELINE_II__
            const int pw = 0;
            for (int ic = 0; ic < IN_CH; ++ic) {
#pragma HLS UNROLL
                incoming_channels[ic] = 0;
            }
            for (int ic = 0; ic < IN_CH; ++ic) {
#pragma HLS UNROLL
                line_buffer[ic][0][pw] = line_buffer[ic][1][pw];
                line_buffer[ic][1][pw] = line_buffer[ic][2][pw];
                line_buffer[ic][2][pw] = incoming_channels[ic];
            }
        }

        for (int w = 0; w < IN_W; ++w) {
#pragma HLS PIPELINE II=__PIPELINE_II__
            const int pw = w + PAD;
            input_axis_t packet = input_stream.read();
            for (int ic = 0; ic < IN_CH; ++ic) {
#pragma HLS UNROLL
                incoming_channels[ic] = static_cast<data_t>(packet.data.range(((ic + 1) * 8) - 1, ic * 8));
            }

            for (int ic = 0; ic < IN_CH; ++ic) {
#pragma HLS UNROLL
                line_buffer[ic][0][pw] = line_buffer[ic][1][pw];
                line_buffer[ic][1][pw] = line_buffer[ic][2][pw];
                line_buffer[ic][2][pw] = incoming_channels[ic];
            }

            if (((h & 1) == 0) || ((w & 1) == 0)) {
                continue;
            }

            const int oh = h / STRIDE;
            const int ow = w / STRIDE;
            const int window_col_base = w - 1;
            ap_uint<OUT_CH * 8> packed_output = 0;

            for (int oc = 0; oc < OUT_CH; ++oc) {
#pragma HLS UNROLL
                acc_t acc = bias_buffer[oc];
                for (int ic = 0; ic < IN_CH; ++ic) {
#pragma HLS UNROLL
                    for (int kh = 0; kh < K; ++kh) {
#pragma HLS UNROLL
                        for (int kw = 0; kw < K; ++kw) {
#pragma HLS UNROLL
                            const int buffer_w = window_col_base + kw;
                            const data_t sample = line_buffer[ic][kh][buffer_w];
                            acc += static_cast<acc_t>(sample) * static_cast<acc_t>(weight_buffer[oc][ic][kh][kw]);
                        }
                    }
                }

                const data_t out_value = APPLY_RELU ? relu6_quant(acc) : saturate_to_data(acc);
                packed_output.range(((oc + 1) * 8) - 1, oc * 8) = static_cast<ap_uint<8>>(out_value);
            }

            output_axis_t out_packet;
            out_packet.data = packed_output;
            out_packet.keep = -1;
            out_packet.strb = -1;
            out_packet.last = ((oh == (OUT_H - 1)) && (ow == (OUT_W - 1))) ? 1 : 0;
            output_stream.write(out_packet);
        }

        {
#pragma HLS PIPELINE II=__PIPELINE_II__
            const int pw = PADDED_W - 1;
            for (int ic = 0; ic < IN_CH; ++ic) {
#pragma HLS UNROLL
                incoming_channels[ic] = 0;
            }
            for (int ic = 0; ic < IN_CH; ++ic) {
#pragma HLS UNROLL
                line_buffer[ic][0][pw] = line_buffer[ic][1][pw];
                line_buffer[ic][1][pw] = line_buffer[ic][2][pw];
                line_buffer[ic][2][pw] = incoming_channels[ic];
            }
        }
    }

    for (int pw = 0; pw < PADDED_W; ++pw) {
#pragma HLS PIPELINE II=__PIPELINE_II__
        for (int ic = 0; ic < IN_CH; ++ic) {
#pragma HLS UNROLL
            incoming_channels[ic] = 0;
        }
        for (int ic = 0; ic < IN_CH; ++ic) {
#pragma HLS UNROLL
            line_buffer[ic][0][pw] = line_buffer[ic][1][pw];
            line_buffer[ic][1][pw] = line_buffer[ic][2][pw];
            line_buffer[ic][2][pw] = incoming_channels[ic];
        }
    }
}

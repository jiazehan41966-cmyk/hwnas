#include "common_defs.h"

static constexpr int CHANNELS = __IN_CHANNELS__;
static constexpr int LOW_H = __SOURCE_H__;
static constexpr int LOW_W = __SOURCE_W__;
static constexpr int OUT_H = __FEATURE_H__;
static constexpr int OUT_W = __FEATURE_W__;
static constexpr int SCALE_H = OUT_H / LOW_H;
static constexpr int SCALE_W = OUT_W / LOW_W;
static constexpr int CH_TILE = (__INPUT_PARALLELISM__ > 0) ? __INPUT_PARALLELISM__ : 1;
static constexpr int MAX_AXIS_BITS = __MAX_AXIS_BITS__;
static constexpr int MAX_AXIS_CHANNELS = ((MAX_AXIS_BITS / 8) > 0) ? (MAX_AXIS_BITS / 8) : 1;
static constexpr int PACK_CH = (CHANNELS > MAX_AXIS_CHANNELS) ? MAX_AXIS_CHANNELS : CHANNELS;
static constexpr int PACKETS_PER_PIXEL = (CHANNELS + PACK_CH - 1) / PACK_CH;

typedef MAKE_AXIS_TYPE(PACK_CH * 8) add_axis_t;

void __TOP_FUNCTION__(
    hls::stream<add_axis_t> &lateral_stream,
    hls::stream<add_axis_t> &topdown_stream,
    hls::stream<add_axis_t> &output_stream
) {
#pragma HLS INTERFACE axis port=lateral_stream
#pragma HLS INTERFACE axis port=topdown_stream
#pragma HLS INTERFACE axis port=output_stream
#pragma HLS INTERFACE s_axilite port=return bundle=control

    data_t low_buffer[CHANNELS][LOW_H][LOW_W];
    data_t lateral_channels[CHANNELS];
    data_t topdown_channels[CHANNELS];
    data_t output_channels[CHANNELS];
#pragma HLS ARRAY_PARTITION variable=low_buffer dim=1 cyclic factor=CH_TILE
#pragma HLS ARRAY_PARTITION variable=lateral_channels dim=1 cyclic factor=CH_TILE
#pragma HLS ARRAY_PARTITION variable=topdown_channels dim=1 cyclic factor=CH_TILE
#pragma HLS ARRAY_PARTITION variable=output_channels dim=1 cyclic factor=CH_TILE

    for (int lh = 0; lh < LOW_H; ++lh) {
        for (int lw = 0; lw < LOW_W; ++lw) {
            for (int packet_idx = 0; packet_idx < PACKETS_PER_PIXEL; ++packet_idx) {
#pragma HLS PIPELINE II=__PIPELINE_II__
                add_axis_t packet = topdown_stream.read();
                unpack_axis_channel_segment<CHANNELS, PACK_CH>(
                    packet,
                    packet_idx * PACK_CH,
                    topdown_channels
                );
            }
            for (int c = 0; c < CHANNELS; ++c) {
#pragma HLS UNROLL factor=CH_TILE
                low_buffer[c][lh][lw] = topdown_channels[c];
            }
        }
    }

    for (int oh = 0; oh < OUT_H; ++oh) {
        for (int ow = 0; ow < OUT_W; ++ow) {
            for (int packet_idx = 0; packet_idx < PACKETS_PER_PIXEL; ++packet_idx) {
#pragma HLS PIPELINE II=__PIPELINE_II__
                add_axis_t packet = lateral_stream.read();
                unpack_axis_channel_segment<CHANNELS, PACK_CH>(
                    packet,
                    packet_idx * PACK_CH,
                    lateral_channels
                );
            }

            const int lh = oh / SCALE_H;
            const int lw = ow / SCALE_W;
            for (int c = 0; c < CHANNELS; ++c) {
#pragma HLS UNROLL factor=CH_TILE
                const acc_t summed =
                    static_cast<acc_t>(lateral_channels[c]) +
                    static_cast<acc_t>(low_buffer[c][lh][lw]);
                output_channels[c] = saturate_to_data(summed);
            }

            for (int packet_idx = 0; packet_idx < PACKETS_PER_PIXEL; ++packet_idx) {
#pragma HLS PIPELINE II=__PIPELINE_II__
                const bool last_packet =
                    (oh == (OUT_H - 1)) &&
                    (ow == (OUT_W - 1)) &&
                    (packet_idx == (PACKETS_PER_PIXEL - 1));
                add_axis_t out_packet = make_axis_segment_packet<add_axis_t, CHANNELS, PACK_CH>(
                    output_channels,
                    packet_idx * PACK_CH,
                    last_packet
                );
                output_stream.write(out_packet);
            }
        }
    }
}

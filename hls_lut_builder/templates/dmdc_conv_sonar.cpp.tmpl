#include "common_defs.h"

static constexpr int IN_CH = __IN_CHANNELS__;
static constexpr int OUT_CH = __OUT_CHANNELS__;
static constexpr int IN_H = __FEATURE_H__;
static constexpr int IN_W = __FEATURE_W__;
static constexpr int K = 3;
static constexpr int BRANCHES = 3;
static constexpr int DILATIONS[BRANCHES] = {1, 3, 5};
static constexpr int CH_TILE = (__ARRAY_PARTITION_FACTOR__ > 0) ? __ARRAY_PARTITION_FACTOR__ : 1;
static constexpr int OUT_TILE = (__OUTPUT_PARALLELISM__ > 0) ? __OUTPUT_PARALLELISM__ : 1;

typedef MAKE_AXIS_TYPE(IN_CH * 8) input_axis_t;
typedef MAKE_AXIS_TYPE(OUT_CH * 8) output_axis_t;

static inline int depth_weight_index(int branch, int c, int kh, int kw) {
    return (((branch * IN_CH + c) * K + kh) * K) + kw;
}

static inline int pointwise_weight_index(int oc, int branch, int ic) {
    return (BRANCHES * IN_CH * K * K) + (oc * BRANCHES * IN_CH) + (branch * IN_CH) + ic;
}

static inline data_t sample_or_zero(data_t frame[IN_CH][IN_H][IN_W], int c, int h, int w) {
    if (h < 0 || h >= IN_H || w < 0 || w >= IN_W) {
        return 0;
    }
    return frame[c][h][w];
}

void __TOP_FUNCTION__(
    hls::stream<input_axis_t> &input_stream,
    hls::stream<output_axis_t> &output_stream,
    const weight_t weights[(BRANCHES * IN_CH * K * K) + (OUT_CH * BRANCHES * IN_CH)],
    const acc_t biases[(BRANCHES * IN_CH) + OUT_CH]
) {
DECLARE_AXIS_INTERFACE()
DECLARE_BRAM_WEIGHTS()
DECLARE_CONTROL_INTERFACE()

    data_t input_frame[IN_CH][IN_H][IN_W];
    data_t incoming_channels[IN_CH];
    data_t branch_channels[BRANCHES][IN_CH];
    data_t output_channels[OUT_CH];
    acc_t acc_tile[OUT_TILE];
#pragma HLS ARRAY_PARTITION variable=incoming_channels dim=1 cyclic factor=CH_TILE
#pragma HLS ARRAY_PARTITION variable=branch_channels dim=1 complete
#pragma HLS ARRAY_PARTITION variable=branch_channels dim=2 cyclic factor=CH_TILE
#pragma HLS ARRAY_PARTITION variable=output_channels dim=1 cyclic factor=OUT_TILE
#pragma HLS ARRAY_PARTITION variable=acc_tile dim=1 complete

    for (int h = 0; h < IN_H; ++h) {
        for (int w = 0; w < IN_W; ++w) {
#pragma HLS PIPELINE II=__PIPELINE_II__
            input_axis_t in_packet = input_stream.read();
            unpack_axis_channels<IN_CH>(in_packet, incoming_channels);
            for (int c = 0; c < IN_CH; ++c) {
#pragma HLS UNROLL factor=CH_TILE
                input_frame[c][h][w] = incoming_channels[c];
            }
        }
    }

    for (int h = 0; h < IN_H; ++h) {
        for (int w = 0; w < IN_W; ++w) {
            for (int branch = 0; branch < BRANCHES; ++branch) {
                const int dilation = DILATIONS[branch];
                for (int ic_base = 0; ic_base < IN_CH; ic_base += CH_TILE) {
                    acc_t branch_acc[CH_TILE];
#pragma HLS ARRAY_PARTITION variable=branch_acc dim=1 complete
                    for (int lane = 0; lane < CH_TILE; ++lane) {
#pragma HLS UNROLL
                        const int ic = ic_base + lane;
                        branch_acc[lane] = (ic < IN_CH) ? biases[(branch * IN_CH) + ic] : static_cast<acc_t>(0);
                    }
                    for (int kh = 0; kh < K; ++kh) {
                        for (int kw = 0; kw < K; ++kw) {
                            const int ih = h + ((kh - 1) * dilation);
                            const int iw = w + ((kw - 1) * dilation);
                            for (int lane = 0; lane < CH_TILE; ++lane) {
#pragma HLS UNROLL
                                const int ic = ic_base + lane;
                                if (ic < IN_CH) {
                                    branch_acc[lane] +=
                                        static_cast<acc_t>(sample_or_zero(input_frame, ic, ih, iw)) *
                                        static_cast<acc_t>(weights[depth_weight_index(branch, ic, kh, kw)]);
                                }
                            }
                        }
                    }
                    for (int lane = 0; lane < CH_TILE; ++lane) {
#pragma HLS UNROLL
                        const int ic = ic_base + lane;
                        if (ic < IN_CH) {
                            branch_channels[branch][ic] = relu6_quant(branch_acc[lane]);
                        }
                    }
                }
            }

            for (int oc_base = 0; oc_base < OUT_CH; oc_base += OUT_TILE) {
                for (int lane = 0; lane < OUT_TILE; ++lane) {
#pragma HLS UNROLL
                    const int oc = oc_base + lane;
                    acc_tile[lane] = (oc < OUT_CH) ? biases[(BRANCHES * IN_CH) + oc] : static_cast<acc_t>(0);
                }
                for (int branch = 0; branch < BRANCHES; ++branch) {
                    for (int ic = 0; ic < IN_CH; ++ic) {
                        const data_t sample = branch_channels[branch][ic];
                        for (int lane = 0; lane < OUT_TILE; ++lane) {
#pragma HLS UNROLL
                            const int oc = oc_base + lane;
                            if (oc < OUT_CH) {
                                acc_tile[lane] +=
                                    static_cast<acc_t>(sample) *
                                    static_cast<acc_t>(weights[pointwise_weight_index(oc, branch, ic)]);
                            }
                        }
                    }
                }
                for (int lane = 0; lane < OUT_TILE; ++lane) {
#pragma HLS UNROLL
                    const int oc = oc_base + lane;
                    if (oc < OUT_CH) {
                        output_channels[oc] = saturate_to_data(acc_tile[lane]);
                    }
                }
            }

            output_axis_t out_packet = make_axis_packet<output_axis_t, OUT_CH>(
                output_channels,
                (h == (IN_H - 1)) && (w == (IN_W - 1))
            );
            output_stream.write(out_packet);
        }
    }
}

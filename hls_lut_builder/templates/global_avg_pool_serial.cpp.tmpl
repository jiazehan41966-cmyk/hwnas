#include "common_defs.h"

static constexpr int IN_CH = __IN_CHANNELS__;
static constexpr int OUT_CH = __OUT_CHANNELS__;
static constexpr int IN_H = __FEATURE_H__;
static constexpr int IN_W = __FEATURE_W__;
static constexpr int CH_TILE = __ARRAY_PARTITION_FACTOR__;
static constexpr int MAX_AXIS_CHANNELS = __MAX_AXIS_BITS__ / 8;
static constexpr int PACK_CH = IN_CH < MAX_AXIS_CHANNELS ? IN_CH : MAX_AXIS_CHANNELS;
static constexpr int PACKETS = (IN_CH + PACK_CH - 1) / PACK_CH;
static constexpr int GROUPS = (PACK_CH + CH_TILE - 1) / CH_TILE;
// Pad the shift register so a partial group never needs a dynamic bit slice.
static constexpr int SHIFT_BITS = GROUPS * CH_TILE * 8;
typedef char gap_requires_same_channels[(IN_CH == OUT_CH && CH_TILE > 0) ? 1 : -1];
typedef MAKE_AXIS_TYPE(PACK_CH * 8) input_axis_t;
typedef MAKE_AXIS_TYPE(PACK_CH * 8) output_axis_t;

void __TOP_FUNCTION__(hls::stream<input_axis_t> &input_stream,
                      hls::stream<output_axis_t> &output_stream,
                      const weight_t weights[1], const acc_t biases[1]) {
DECLARE_AXIS_INTERFACE()
DECLARE_BRAM_WEIGHTS()
DECLARE_CONTROL_INTERFACE()
    (void)weights;
    (void)biases;
    acc_t channel_sums[OUT_CH];
#pragma HLS ARRAY_PARTITION variable=channel_sums cyclic factor=CH_TILE
#pragma HLS BIND_STORAGE variable=channel_sums type=ram_2p impl=bram
    for (int c = 0; c < OUT_CH; ++c) {
#pragma HLS PIPELINE II=__PIPELINE_II__
        channel_sums[c] = 0;
    }
    for (int pixel = 0; pixel < IN_H * IN_W; ++pixel) {
        for (int packet = 0; packet < PACKETS; ++packet) {
            input_axis_t in_packet = input_stream.read();
            ap_uint<SHIFT_BITS> shift = in_packet.data;
            for (int group = 0; group < GROUPS; ++group) {
#pragma HLS PIPELINE II=__PIPELINE_II__
                for (int lane = 0; lane < CH_TILE; ++lane) {
#pragma HLS UNROLL
                    const int local = group * CH_TILE + lane;
                    const int c = packet * PACK_CH + local;
                    if (local < PACK_CH && c < OUT_CH) {
                        data_t value = static_cast<data_t>(shift.range(lane * 8 + 7, lane * 8));
                        channel_sums[c] += static_cast<acc_t>(value);
                    }
                }
                shift >>= CH_TILE * 8;
            }
        }
    }
    for (int packet = 0; packet < PACKETS; ++packet) {
        ap_uint<SHIFT_BITS> packed = 0;
        for (int group = 0; group < GROUPS; ++group) {
#pragma HLS PIPELINE II=__PIPELINE_II__
            ap_uint<CH_TILE * 8> values = 0;
            for (int lane = 0; lane < CH_TILE; ++lane) {
#pragma HLS UNROLL
                const int local = group * CH_TILE + lane;
                const int c = packet * PACK_CH + local;
                if (local < PACK_CH && c < OUT_CH) {
                    data_t value = saturate_to_data(channel_sums[c] / (IN_H * IN_W));
                    values.range(lane * 8 + 7, lane * 8) = static_cast<ap_uint<8>>(value);
                }
            }
            packed >>= CH_TILE * 8;
            packed.range(SHIFT_BITS - 1, SHIFT_BITS - CH_TILE * 8) = values;
        }
        output_axis_t out_packet;
        out_packet.data = packed;
        out_packet.keep = -1;
        out_packet.strb = -1;
        out_packet.last = packet == PACKETS - 1;
        output_stream.write(out_packet);
    }
}
